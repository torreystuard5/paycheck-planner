# Copy to ".env" and adjust. Never commit ".env".
# Local Postgres via Docker Compose (repo root) uses host port 5433 — see docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://paydrift:paydrift@localhost:5433/paydrift
SECRET_KEY=dev-secret-change-me

# Comma-separated browser origins allowed to call the API (CORS).
# FRONTEND_ORIGIN is optional: used as an extra dev default (see app/main.py).
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Cloudflare R2 storage (optional — presign endpoint returns 503 if unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=                  # https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=               # optional — leave blank for private bucket
R2_PRESIGNED_URL_TTL=900          # seconds (15 min default)
R2_MAX_UPLOAD_BYTES=15728640      # 15 MB default
